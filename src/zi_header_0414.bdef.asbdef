managed;
strict ( 2 );
with draft;

define behavior for ZI_HEADER_0414 alias Header
implementation in class zbp_i_header_0414 unique
persistent table zheader_0414
draft table zheader_0414_d
lock master total etag LastChangedAt
authorization master ( instance )
etag master LocalLastChangeAt
{
  create ( authorization : global );
  update;
  delete;
  field (mandatory) id, Email;
  field( features: instance ) Createon, Imageurl, LastChangedAt, LocalLastChangeAt;

  association _Items { create; }

  draft action Resume;
  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft determine action Prepare;

  determination setLastChange on save  { create; update; }

  validation validateOrderEmail on save { create; field Email; }
  determine action validateOrderEmailValue  { validation validateOrderEmail; }
  validation validateOrderStatus on save { create; field Orderstatus; }
  determine action validateOrderStatusID  { validation validateOrderStatus; }

  side effects {
    determine action validateOrderStatusID executed on field Orderstatus affects messages;
    determine action validateOrderEmailValue executed on field Email affects messages;
  }

  mapping for zheader_0414
    {
      id                = id;
      email             = email;
      firstname         = firstname;
      lastname          = lastname;
      Country           = country;
      Createon          = createon;
      Deliverydate      = deliverydate;
      Orderstatus       = orderstatus;
      Imageurl          = imageurl;
      LastChangedAt     = last_change_at;
      LocalLastChangeAt = local_last_changed_at;
    }
}

define behavior for ZI_ITEMS_0414 alias Items
implementation in class zbp_i_items_0414 unique
persistent table zitems_0414
draft table zitems_0414_d
lock dependent by _Header
authorization dependent by _Header
etag master LocalLastChangeAt
{

  update;
  delete;
  field ( readonly ) Id, LastChangedAt, LocalLastChangeAt;
  field (mandatory) uuid, Name, Description;
  association _Header { with draft; }

  validation validateName on save { create; field Name; }
  determine action validateNameValue  { validation validateName; }

  validation validateDescription on save { create; field Description; }
  determine action validateDescriptionValue  { validation validateDescription; }

  side effects {
    determine action validateNameValue executed on field Name affects messages;
    determine action validateDescriptionValue executed on field Description affects messages;
  }

  mapping for zitems_0414
    {
      Id                = id;
      uuid              = item_uuid;
      name              = name;
      Description       = description;
      Releasedate       = releasedate;
      Discontinueddate  = discontinueddate;
      Price             = price;
      Waers             = waers;
      Height            = height;
      Width             = width;
      Depth             = depth;
      DimensionsUom     = dimensions_uom;
      Quantity          = quantity;
      Unitofmeasure     = unitofmeasure;
      LastChangedAt     = last_change_at;
      LocalLastChangeAt = local_last_changed_at;
    }
}